<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FastTPV.Desktop.Features.ReportsWindow" Width="1150" Height="760" Title="Reports" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">
    <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Reports" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/><DatePicker x:Name="From"/><DatePicker x:Name="To"/><Button Content="Refresh" Click="Refresh" Padding="16,8" Background="#2563EB" Foreground="White"/></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,18">
      <Border Background="#EFF6FF" Padding="18" Margin="0,0,6,0"><StackPanel><TextBlock Text="Sales total"/><TextBlock x:Name="SalesTotal" Text="0.00" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#F0FDF4" Padding="18" Margin="6,0,6,0"><StackPanel><TextBlock Text="Transactions"/><TextBlock x:Name="TransactionCount" Text="0" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
      <Border Grid.Column="2" Background="#FFF7ED" Padding="18" Margin="6,0,0,0"><StackPanel><TextBlock Text="Low stock"/><TextBlock x:Name="LowStockCount" Text="0" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
    </Grid>

    <!-- Register Summary (X/Z Report): the numbers a mid-shift check (X) or an
         end-of-day close-out (Z) needs, for whatever range From/To above are set to.
         Uses the same ReportsService the cards above use, so Refresh reloads both. -->
    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Register Summary (X/Z Report)" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <Grid ColumnDefinitions="*,*,*,*">
          <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Gross subtotal" Foreground="#666"/><TextBlock x:Name="SummaryGross" Text="0.00" FontSize="18" FontWeight="Bold"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,6,0"><TextBlock Text="Discounts" Foreground="#666"/><TextBlock x:Name="SummaryDiscount" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/></StackPanel>
          <StackPanel Grid.Column="2" Margin="6,0,6,0"><TextBlock Text="Tax" Foreground="#666"/><TextBlock x:Name="SummaryTax" Text="0.00" FontSize="18" FontWeight="Bold"/></StackPanel>
          <StackPanel Grid.Column="3" Margin="6,0,0,0"><TextBlock Text="Net total" Foreground="#666"/><TextBlock x:Name="SummaryNet" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/></StackPanel>
        </Grid>
        <TextBlock Text="By payment method" FontWeight="Bold" Margin="0,14,0,6"/>
        <ItemsControl x:Name="PaymentBreakdownList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="140,*,120" Margin="0,2">
                <TextBlock Text="{Binding Method}"/>
                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0} sale(s)'}" Foreground="#666"/>
                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:C}'}" HorizontalAlignment="Right" FontWeight="Bold"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="3*,2*">
      <StackPanel Margin="0,0,9,0">
        <TextBlock Text="Sales history" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <ListBox x:Name="SalesList">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="130,*,90,80,90,90" Margin="8">
                <TextBlock Text="{Binding TicketNumber}"/>
                <TextBlock Grid.Column="1" Text="{Binding SaleDate}"/>
                <TextBlock Grid.Column="2" Text="{Binding Status}"/>
                <TextBlock Grid.Column="3" Text="{Binding TotalAmount}" HorizontalAlignment="Right"/>
                <Button Grid.Column="4" Content="Reprint" Click="ReprintSale" Padding="8,4" FontSize="11" Margin="4,0"/>
                <Button Grid.Column="5" Content="Void" Click="VoidSale" Padding="8,4" FontSize="11" Background="#DC2626" Foreground="White"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="9,0,0,0">
        <TextBlock Text="Low-stock articles" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <ListBox x:Name="LowStockList">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,100,100" Margin="8">
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding StockLevel}"/>
                <TextBlock Grid.Column="2" Text="{Binding MinimumStock}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Message" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
