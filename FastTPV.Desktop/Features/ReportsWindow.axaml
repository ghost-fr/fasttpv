<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTPV.Desktop.Features.ReportsWindow"
        Width="1150" Height="760" Title="Reports"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Classes="app">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24" RowSpacing="16">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="Reports" Classes="h1" VerticalAlignment="Center"/>
      <DatePicker x:Name="From"/>
      <DatePicker x:Name="To"/>
      <Button Content="Refresh" Click="Refresh" Classes="primary"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
      <Border Classes="card" Padding="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Sales total" Classes="muted"/>
          <TextBlock x:Name="SalesTotal" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Padding="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Transactions" Classes="muted"/>
          <TextBlock x:Name="TransactionCount" Text="0" FontSize="24" FontWeight="Bold"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Padding="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Low stock" Classes="muted"/>
          <TextBlock x:Name="LowStockCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="card" Padding="18">
      <StackPanel>
        <TextBlock Text="Register Summary (X/Z Report)" Classes="h2" Margin="0,0,0,10"/>
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
          <StackPanel>
            <TextBlock Text="Gross subtotal" Classes="muted"/>
            <TextBlock x:Name="SummaryGross" Text="0.00" FontSize="18" FontWeight="Bold"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Discounts" Classes="muted"/>
            <TextBlock x:Name="SummaryDiscount" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Tax" Classes="muted"/>
            <TextBlock x:Name="SummaryTax" Text="0.00" FontSize="18" FontWeight="Bold"/>
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="Net total" Classes="muted"/>
            <TextBlock x:Name="SummaryNet" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="By payment method" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <ItemsControl x:Name="PaymentBreakdownList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="140,*,120" Margin="0,2">
                <TextBlock Text="{Binding Method}"/>
                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0} sale(s)'}" Classes="muted"/>
                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:C}'}" HorizontalAlignment="Right" FontWeight="Bold"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="3*,2*" ColumnSpacing="16">
      <Border Classes="panel" CornerRadius="14" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Sales history" Classes="h2" Margin="0,0,0,8"/>
          <ListBox x:Name="SalesList" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="130,*,90,80,90,90" Margin="8">
                  <TextBlock Text="{Binding TicketNumber}"/>
                  <TextBlock Grid.Column="1" Text="{Binding SaleDate}" Classes="muted"/>
                  <TextBlock Grid.Column="2" Text="{Binding Status}"/>
                  <TextBlock Grid.Column="3" Text="{Binding TotalAmount}" HorizontalAlignment="Right"/>
                  <Button Grid.Column="4" Content="Reprint" Click="ReprintSale" Classes="btn" Padding="8,4" FontSize="11" Margin="4,0"/>
                  <Button Grid.Column="5" Content="Void" Click="VoidSale" Classes="danger" Padding="8,4" FontSize="11"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Classes="panel" CornerRadius="14" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Low-stock articles" Classes="h2" Margin="0,0,0,8"/>
          <TextBlock DockPanel.Dock="Bottom" x:Name="Message" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <ListBox x:Name="LowStockList" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,100,100" Margin="8">
                  <TextBlock Text="{Binding Name}"/>
                  <TextBlock Grid.Column="1" Text="{Binding StockLevel}"/>
                  <TextBlock Grid.Column="2" Text="{Binding MinimumStock}" Classes="muted"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
