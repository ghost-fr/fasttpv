<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTPV.Desktop.Features.CashDrawerWindow"
        Width="640" Height="660" Title="Cash Drawer"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Classes="app">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <TextBlock Text="Cash Drawer" Classes="h1"/>

    <StackPanel x:Name="OpenPanel" Grid.Row="1" Spacing="12" IsVisible="False">
      <Border Classes="card" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="No till session is open." FontWeight="Bold"/>
          <TextBlock Text="Count the cash you're starting with and open a session before taking sales." Classes="muted" TextWrapping="Wrap"/>
          <TextBox x:Name="OpeningFloat" Classes="field" Watermark="Starting float amount"/>
          <TextBlock x:Name="OpenMessage" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
          <Button Content="Open till" Click="OpenSession" Classes="primary" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer x:Name="SessionPanel" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="14">
        <Border Classes="card" Padding="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock x:Name="SessionInfo" FontWeight="Bold"/>
              <TextBlock x:Name="FloatInfo" Classes="muted"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Kick drawer" Click="KickDrawer" Classes="btn" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <TextBlock x:Name="KickMessage" FontSize="12" Classes="muted" TextWrapping="Wrap"/>

        <TextBlock Text="Cash movements" Classes="h2"/>
        <Grid ColumnDefinitions="*,2*,Auto,Auto">
          <TextBox x:Name="MovementAmount" Classes="field" Watermark="Amount"/>
          <TextBox x:Name="MovementReason" Grid.Column="1" Classes="field" Watermark="Reason (e.g. banking drop, paid-out)"/>
          <Button Grid.Column="2" Content="Cash In" Click="CashIn" Classes="cash"/>
          <Button Grid.Column="3" Content="Cash Out" Click="CashOut" Classes="danger"/>
        </Grid>
        <TextBlock x:Name="MovementMessage" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>

        <Border Classes="panel" CornerRadius="12" Padding="8" Height="160">
          <ListBox x:Name="MovementsList" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="70,*,90" Margin="6">
                  <TextBlock Text="{Binding Type}" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="{Binding Reason}" Classes="muted"/>
                  <TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <TextBlock Text="Close till" Classes="h2"/>
        <TextBlock Text="Count all the cash in the drawer (including the float) and enter it below." Classes="muted" TextWrapping="Wrap"/>
        <TextBox x:Name="CountedCash" Classes="field" Watermark="Counted cash total"/>
        <Button Content="Preview close-out" Click="PreviewClose" Classes="btn" HorizontalAlignment="Left"/>

        <Border x:Name="PreviewBox" Classes="card" Padding="16" IsVisible="False">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Opening float" Classes="muted"/><TextBlock x:Name="PreviewFloat" Grid.Column="1"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Cash sales this session" Classes="muted"/><TextBlock x:Name="PreviewCashSales" Grid.Column="1"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Cash in" Classes="muted"/><TextBlock x:Name="PreviewCashIn" Grid.Column="1"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Cash out" Classes="muted"/><TextBlock x:Name="PreviewCashOut" Grid.Column="1"/></Grid>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4"/>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Expected" FontWeight="Bold"/><TextBlock x:Name="PreviewExpected" Grid.Column="1" FontWeight="Bold"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Counted" Classes="muted"/><TextBlock x:Name="PreviewCounted" Grid.Column="1"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Variance" FontWeight="Bold"/><TextBlock x:Name="PreviewVariance" Grid.Column="1" FontWeight="Bold"/></Grid>
            <Button Content="Confirm and close till" Click="ConfirmClose" Classes="danger" Margin="0,10,0,0" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="CloseMessage" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
