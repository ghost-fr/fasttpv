<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTPV.Desktop.Features.PrinterSettingsWindow"
        Width="500" Height="640"
        Title="Printer Settings"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Classes="app">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="10">
      <TextBlock Text="Printer Settings" Classes="h1" FontSize="22"/>
      <TextBlock TextWrapping="Wrap" Classes="muted" Margin="0,0,0,6"
                 Text="Every thermal printer's firmware can differ slightly. Pick a starting point below, then use Send test print before saving."/>

      <TextBlock Text="Connection type" FontWeight="SemiBold"/>
      <ComboBox x:Name="Connection" Classes="field" HorizontalAlignment="Stretch">
        <ComboBoxItem Tag="None" Content="None — save receipts as a file only, no hardware"/>
        <ComboBoxItem Tag="Network" Content="Network / WiFi thermal printer (recommended)"/>
        <ComboBoxItem Tag="WindowsShell" Content="Regular document printer (Windows only)"/>
      </ComboBox>

      <TextBlock Text="Printer IP address (Network only)" Classes="muted"/>
      <TextBox x:Name="IpAddress" Classes="field" Watermark="e.g. 192.168.1.50"/>

      <TextBlock Text="Port (Network only — 9100 is usual)" Classes="muted"/>
      <TextBox x:Name="Port" Classes="field" Text="9100"/>

      <TextBlock Text="Windows printer name (Windows document printer only)" Classes="muted"/>
      <TextBox x:Name="PrinterName" Classes="field"/>

      <TextBlock Text="Paper width" FontWeight="SemiBold" Margin="0,6,0,0"/>
      <ComboBox x:Name="PaperWidth" Classes="field" HorizontalAlignment="Stretch">
        <ComboBoxItem Tag="80mm" Content="80mm (standard — most countertop printers)"/>
        <ComboBoxItem Tag="58mm" Content="58mm (compact / portable printers)"/>
      </ComboBox>

      <TextBlock Text="Character set / code page" FontWeight="SemiBold" Margin="0,6,0,0"/>
      <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                 Text="Pick the one that prints accented characters correctly in the test print."/>
      <ComboBox x:Name="CodePage" Classes="field" HorizontalAlignment="Stretch">
        <ComboBoxItem Tag="16" Content="16 — WPC1252 / Western Europe (most common default)"/>
        <ComboBoxItem Tag="0" Content="0 — PC437 (USA / Standard Europe)"/>
        <ComboBoxItem Tag="2" Content="2 — PC850 (Multilingual)"/>
        <ComboBoxItem Tag="19" Content="19 — PC858 (Euro)"/>
        <ComboBoxItem Tag="255" Content="255 — Custom / other (rarely needed)"/>
      </ComboBox>

      <TextBlock Text="Paper cut command" FontWeight="SemiBold" Margin="0,6,0,0"/>
      <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                 Text="If the receipt prints but the paper isn't cut, switch this and test again."/>
      <ComboBox x:Name="CutStyle" Classes="field" HorizontalAlignment="Stretch">
        <ComboBoxItem Tag="Standard" Content="Standard (try this first)"/>
        <ComboBoxItem Tag="TwoParameter" Content="Two-parameter (older / clone printers)"/>
        <ComboBoxItem Tag="None" Content="No cut command (tear off manually)"/>
      </ComboBox>

      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
        <Button x:Name="TestPrintButton" Content="Send test print" Click="TestPrint" Classes="primary"/>
        <Button Content="Save" Click="Save" Classes="cash"/>
      </StackPanel>

      <TextBlock x:Name="Message" TextWrapping="Wrap" Classes="muted" Margin="0,10,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
