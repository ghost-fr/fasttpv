<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTPV.Desktop.Features.ChangePasswordWindow"
        Width="440" Height="460" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Change password"
        RequestedThemeVariant="Dark"
        Classes="app">
  <Border Classes="card" Margin="24" Padding="28">
    <StackPanel Spacing="12">
      <TextBlock Text="Change your password" Classes="h1" FontSize="22"/>
      <TextBox x:Name="CurrentPassword" Classes="field" Watermark="Current password" PasswordChar="*" Margin="0,8,0,0"/>
      <TextBox x:Name="NewPassword" Classes="field" Watermark="New password" PasswordChar="*"/>
      <TextBox x:Name="ConfirmPassword" Classes="field" Watermark="Confirm new password" PasswordChar="*"/>
      <TextBlock Text="At least 8 characters, with an uppercase letter, a lowercase letter, and a digit."
                 Classes="muted" FontSize="12" TextWrapping="Wrap"/>
      <TextBlock x:Name="Message" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
      <Button Content="Change password" Click="Submit" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>
  </Border>
</Window>
