<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FastTPV.Desktop.Features.ChangePasswordWindow" Width="420" Height="380" CanResize="False" WindowStartupLocation="CenterOwner" Title="Change password">
  <StackPanel Margin="30" Spacing="12">
    <TextBlock Text="Change your password" FontSize="22" FontWeight="Bold"/>
    <TextBox x:Name="CurrentPassword" Watermark="Current password" PasswordChar="*" Margin="0,10,0,0"/>
    <TextBox x:Name="NewPassword" Watermark="New password" PasswordChar="*"/>
    <TextBox x:Name="ConfirmPassword" Watermark="Confirm new password" PasswordChar="*"/>
    <TextBlock Text="At least 8 characters, with an uppercase letter, a lowercase letter, and a digit." Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
    <TextBlock x:Name="Message" Foreground="#B91C1C" TextWrapping="Wrap"/>
    <Button Content="Change password" Click="Submit" HorizontalContentAlignment="Center" Padding="12" Background="#2563EB" Foreground="White"/>
  </StackPanel>
</Window>
