<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTPV.Desktop.Features.UsersWindow"
        Width="900" Height="620" Title="Users"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Classes="app">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,3*" Margin="24">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
      <TextBlock Text="Users" Classes="h1" VerticalAlignment="Center"/>
      <Button Content="New user" Click="NewUser" Classes="primary"/>
    </StackPanel>
    <Border Grid.Row="1" Classes="panel" CornerRadius="14" Padding="8">
      <ListBox x:Name="UserList" SelectionChanged="UserSelected" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="10,8" Spacing="2">
              <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
              <TextBlock Text="{Binding UserName}" Classes="muted" FontSize="12"/>
              <TextBlock Text="{Binding Role}" Foreground="{DynamicResource CyanBrush}" FontSize="12"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Classes="card" Padding="22">
      <StackPanel Spacing="10">
        <TextBlock Text="User details" Classes="h2"/>
        <TextBox x:Name="UserName" Classes="field" Watermark="Username *"/>
        <TextBox x:Name="DisplayName" Classes="field" Watermark="Display name *"/>
        <ComboBox x:Name="Role" Classes="field" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Cashier"/>
          <ComboBoxItem Content="Admin"/>
        </ComboBox>
        <CheckBox x:Name="IsActive" Content="Active" IsChecked="True"/>
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,6"/>
        <TextBox x:Name="NewPassword" Classes="field" Watermark="Password (min 8 chars, upper+lower+digit)" PasswordChar="*"/>
        <TextBlock Text="For a new user this sets their initial password. For an existing user, filling this in and clicking Save resets it."
                   Classes="muted" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock x:Name="Message" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Save" Click="Save" Classes="cash" Padding="18,10"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
