<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FastTPV.Desktop.Features.ApprovalDialog" Width="380" Height="300" CanResize="False" WindowStartupLocation="CenterOwner" Title="Manager approval required">
  <StackPanel Margin="28" Spacing="10">
    <TextBlock Text="Manager approval required" FontSize="18" FontWeight="Bold"/>
    <TextBlock x:Name="Reason" Text="This action needs an Admin to approve it." Foreground="#64748B" TextWrapping="Wrap"/>
    <TextBox x:Name="Username" Watermark="Admin username" Margin="0,10,0,0"/>
    <TextBox x:Name="Password" Watermark="Admin password" PasswordChar="*"/>
    <TextBlock x:Name="Message" Foreground="#B91C1C" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
      <Button Content="Approve" Click="Approve" Padding="16,8" Background="#16A34A" Foreground="White"/>
      <Button Content="Cancel" Click="Cancel" Padding="16,8"/>
    </StackPanel>
  </StackPanel>
</Window>
