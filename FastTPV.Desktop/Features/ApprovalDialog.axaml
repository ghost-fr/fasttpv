<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTPV.Desktop.Features.ApprovalDialog"
        Width="400" Height="340" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Manager approval required"
        RequestedThemeVariant="Dark"
        Classes="app">
  <Border Classes="card" Margin="20" Padding="24">
    <StackPanel Spacing="12">
      <TextBlock Text="Manager approval required" Classes="h2"/>
      <TextBlock x:Name="Reason" Text="This action needs an Admin to approve it." Classes="muted" TextWrapping="Wrap"/>
      <TextBox x:Name="Username" Classes="field" Watermark="Admin username" Margin="0,6,0,0"/>
      <TextBox x:Name="Password" Classes="field" Watermark="Admin password" PasswordChar="*"/>
      <TextBlock x:Name="Message" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
        <Button Content="Approve" Click="Approve" Classes="cash" Padding="16,10"/>
        <Button Content="Cancel" Click="Cancel" Classes="btn" Padding="16,10"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
