<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTPV.Desktop.Features.SupplierWindow"
        Width="1000" Height="640" Title="Suppliers"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Classes="app">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,3*" Margin="24">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
      <TextBlock Text="Suppliers" Classes="h1" VerticalAlignment="Center"/>
      <TextBox x:Name="Search" Classes="field" Width="280" Watermark="Search name, code or email" TextChanged="SearchChanged"/>
      <Button Content="New supplier" Click="NewSupplier" Classes="primary"/>
    </StackPanel>
    <Border Grid.Row="1" Classes="panel" CornerRadius="14" Padding="8">
      <ListBox x:Name="SupplierList" SelectionChanged="SupplierSelected" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="10,8" Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
              <TextBlock Text="{Binding Code}" Classes="muted" FontSize="12"/>
              <TextBlock Text="{Binding Email}" Classes="dim" FontSize="12"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Classes="card" Padding="22">
      <StackPanel Spacing="10">
        <TextBlock Text="Supplier details" Classes="h2"/>
        <TextBox x:Name="Code" Classes="field" Watermark="Code *"/>
        <TextBox x:Name="Name" Classes="field" Watermark="Name *"/>
        <Grid ColumnDefinitions="*,*">
          <TextBox x:Name="Email" Classes="field" Watermark="Email" Margin="0,0,5,0"/>
          <TextBox x:Name="Phone" Grid.Column="1" Classes="field" Watermark="Phone" Margin="5,0,0,0"/>
        </Grid>
        <TextBox x:Name="Address" Classes="field" Watermark="Address"/>
        <TextBox x:Name="ContactName" Classes="field" Watermark="Contact person"/>
        <TextBox x:Name="TaxId" Classes="field" Watermark="Tax ID"/>
        <CheckBox x:Name="IsActive" Content="Active" IsChecked="True"/>
        <TextBlock x:Name="Message" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Save" Click="Save" Classes="cash" Padding="18,10"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
