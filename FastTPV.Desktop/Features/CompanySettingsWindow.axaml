<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTPV.Desktop.Features.CompanySettingsWindow"
        Width="560" Height="720"
        Title="Company Settings"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Classes="app">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="10">
      <TextBlock Text="Company Settings" Classes="h1" FontSize="22"/>
      <TextBlock TextWrapping="Wrap" Classes="muted" Margin="0,0,0,6"
                 Text="These details appear on receipts and identify your business. Empty fields are skipped so the header stays clean."/>

      <TextBlock Text="Business name *" FontWeight="SemiBold"/>
      <TextBox x:Name="BusinessName" Classes="field" Watermark="Legal / trading name shown on receipts"/>

      <TextBlock Text="Trade name (optional)" Classes="muted"/>
      <TextBox x:Name="TradeName" Classes="field" Watermark="Only if different from business name"/>

      <TextBlock Text="Tax ID / CIF / NIF / VAT" Classes="muted"/>
      <TextBox x:Name="TaxId" Classes="field" Watermark="e.g. B12345678"/>

      <TextBlock Text="Address" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBox x:Name="AddressLine1" Classes="field" Watermark="Street and number"/>
      <TextBox x:Name="AddressLine2" Classes="field" Watermark="Floor, suite, building (optional)"/>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="Postal code" Classes="muted"/>
          <TextBox x:Name="PostalCode" Classes="field"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="City" Classes="muted"/>
          <TextBox x:Name="City" Classes="field"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="Province / State" Classes="muted"/>
          <TextBox x:Name="Province" Classes="field"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="Country" Classes="muted"/>
      <TextBox x:Name="Country" Classes="field"/>

      <TextBlock Text="Contact" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="Phone" Classes="muted"/>
          <TextBox x:Name="Phone" Classes="field"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Email" Classes="muted"/>
          <TextBox x:Name="Email" Classes="field"/>
        </StackPanel>
      </Grid>
      <TextBlock Text="Website" Classes="muted"/>
      <TextBox x:Name="Website" Classes="field" Watermark="https://..."/>

      <TextBlock Text="Receipt text" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBox x:Name="ReceiptHeader" Classes="field" Watermark="Extra header lines (optional)" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/>
      <TextBox x:Name="ReceiptFooter" Classes="field" Watermark="Footer / thank-you message" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/>
      <TextBox x:Name="LogoPath" Classes="field" Watermark="Logo path (optional)"/>

      <TextBlock x:Name="Message" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MinHeight="36"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
        <Button Content="Cancel" Click="Cancel" Classes="btn" Width="100"/>
        <Button x:Name="SaveButton" Content="Save" Click="Save" Classes="primary" Width="120"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
