<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FastTPV.Desktop.Features.LoginWindow"
        Width="440" Height="480" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="FastTPV - Sign in"
        RequestedThemeVariant="Dark"
        Classes="app">
  <Border Classes="card" Margin="28" Padding="32">
    <StackPanel Spacing="14">
      <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource PrimaryGradient}" HorizontalAlignment="Left">
        <Path Data="{StaticResource IconCart}" Stretch="Uniform" Width="22" Height="22"
              Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="FastTPV" Classes="h1"/>
      <TextBlock Text="Sign in to continue" Classes="muted"/>
      <TextBox x:Name="UserName" Classes="field" Watermark="Username" Margin="0,8,0,0"/>
      <TextBox x:Name="Password" Classes="field" Watermark="Password" PasswordChar="*"/>
      <TextBlock x:Name="Message" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
      <Button Content="Sign in" Click="SignIn" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>
  </Border>
</Window>
