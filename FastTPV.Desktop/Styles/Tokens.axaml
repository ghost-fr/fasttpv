<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Colour tokens ===== -->
    <SolidColorBrush x:Key="BgBrush"          Color="#0B0F1A"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#111728"/>
    <SolidColorBrush x:Key="Surface2Brush"    Color="#182036"/>
    <SolidColorBrush x:Key="LineBrush"        Color="#232D47"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#E9EDF7"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="#8B96B0"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#5B6785"/>
    <SolidColorBrush x:Key="PrimaryBrush"     Color="#6C63FF"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#221F55"/>
    <SolidColorBrush x:Key="CyanBrush"        Color="#22D3EE"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="#22C55E"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="#F43F5E"/>
    <SolidColorBrush x:Key="DangerSoftBrush"  Color="#2A1420"/>
    <SolidColorBrush x:Key="WarnBrush"        Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarnSoftBrush"    Color="#33260A"/>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#5B4FFF" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThumbGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#182036" Offset="0"/>
        <GradientStop Color="#0F1730" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Icons (Lucide-style, 24x24 viewbox, drawn with Path Data + stroke) ===== -->
