<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FastTPV.Desktop.ViewModels"
        xmlns:conv="using:FastTPV.Desktop.Converters"
        x:Class="FastTPV.Desktop.Views.SalesWindow"
        x:DataType="vm:SalesWindowViewModel"
        Title="Sales / POS Module"
        WindowState="Maximized"
        RequestedThemeVariant="Dark"
        Classes="app">

    <Window.Resources>
        <conv:LowStockConverter x:Key="LowStock"/>
        <conv:StockLabelConverter x:Key="StockLabel"/>
    </Window.Resources>

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,420">

        <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="24">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Border Classes="panel" CornerRadius="14" Padding="4" Margin="0,0,12,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconSearch}" Margin="12,0,4,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Classes="field" BorderThickness="0" Background="Transparent"
                                 Watermark="Search by name or code, or scan a barcode..."
                                 Text="{Binding SearchText}" KeyDown="SearchKeyDown"/>
                    </Grid>
                </Border>
                <ComboBox Grid.Column="1" Classes="field" MinWidth="220"
                          ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Classes="muted" FontSize="12" Margin="0,12,0,0"/>

            <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,12,0,0">
                <ListBox Grid.Row="0" Classes="chips" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}" Margin="0,0,0,12">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding FilteredProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="tile" Width="196" Margin="0,0,14,14"
                                        Command="{Binding $parent[ItemsControl].((vm:SalesWindowViewModel)DataContext).AddToCartCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="10">
                                        <Border Height="88" CornerRadius="12" Background="{DynamicResource ThumbGradient}">
                                            <Path Classes="icon" Width="34" Height="34" Data="{StaticResource IconPackage}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource CyanBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="price" Text="{Binding Price, StringFormat='{}{0:C}'}"/>
                                            <Border Grid.Column="1" VerticalAlignment="Center"
                                                    Classes="stockOk"
                                                    Classes.stockLow="{Binding Converter={StaticResource LowStock}}">
                                                <TextBlock Text="{Binding Converter={StaticResource StockLabel}}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="0" Grid.Column="1" Classes="panel" BorderThickness="1,0,0,0" Padding="24">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Current sale" Classes="h1" FontSize="22"/>
                        <TextBlock Text="{Binding LastTicketNumber, StringFormat='Last ticket: {0}'}" Classes="muted" FontSize="12"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="danger" Command="{Binding ClearCartCommand}" VerticalAlignment="Top">
                        <Path Classes="icon" Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding ArticleName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <Button Grid.Column="1" Classes="ghost" Padding="6"
                                                    Command="{Binding $parent[ItemsControl].((vm:SalesWindowViewModel)DataContext).RemoveLineCommand}"
                                                    CommandParameter="{Binding}">
                                                <Path Classes="icon" Data="{StaticResource IconX}" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                            <Button Grid.Column="0" Classes="btn" Width="32" Height="32" Padding="0"
                                                    Command="{Binding $parent[ItemsControl].((vm:SalesWindowViewModel)DataContext).DecrementLineCommand}"
                                                    CommandParameter="{Binding}">
                                                <Path Classes="icon" Data="{StaticResource IconMinus}" Width="14" Height="14"/>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" Width="34"
                                                       TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                            <Button Grid.Column="2" Classes="btn" Width="32" Height="32" Padding="0"
                                                    Command="{Binding $parent[ItemsControl].((vm:SalesWindowViewModel)DataContext).IncrementLineCommand}"
                                                    CommandParameter="{Binding}">
                                                <Path Classes="icon" Data="{StaticResource IconPlus}" Width="14" Height="14"/>
                                            </Button>
                                            <TextBlock Grid.Column="4" Text="{Binding LineTotal, StringFormat='{}{0:C}'}"
                                                       VerticalAlignment="Center" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Classes="field" Padding="10,6" MinHeight="0" Margin="0,0,8,0"
                                                     Watermark="Line discount %" FontSize="12"
                                                     Text="{Binding DiscountPercentText}"/>
                                            <Button Grid.Column="1" Classes="btn" Padding="12,6" FontSize="12"
                                                    Content="Apply"
                                                    Command="{Binding $parent[ItemsControl].((vm:SalesWindowViewModel)DataContext).SetLineDiscountCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding DiscountAmount, StringFormat='Discount: -{0:C}'}"
                                                   FontSize="11" Foreground="{DynamicResource DangerBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0">
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Classes="field" Padding="12,8" MinHeight="0" Margin="0,0,8,0"
                                 Watermark="Ticket discount %" Text="{Binding TicketDiscountPercentText}"/>
                        <Button Grid.Column="1" Classes="btn" Content="Apply" Command="{Binding ApplyTicketDiscountCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Subtotal" Classes="muted"/>
                        <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:C}'}" Classes="muted"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Ticket discount" Classes="muted"/>
                        <TextBlock Grid.Column="1" Text="{Binding TicketDiscountAmount, StringFormat='-{0:C}'}"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Tax" Classes="muted"/>
                        <TextBlock Grid.Column="1" Text="{Binding Tax, StringFormat='{}{0:C}'}" Classes="muted"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource LineBrush}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="TOTAL" Classes="caption" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:C}'}" Classes="total"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Classes="cash" Height="72" Margin="0,0,5,0"
                                Command="{Binding CompleteSaleCommand}" CommandParameter="Cash">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <Path Data="{StaticResource IconCash}" Stretch="Uniform" Width="22" Height="22"
                                      Stroke="#052E16" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="Cash" HorizontalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="card" Height="72" Margin="5,0,5,0"
                                Command="{Binding CompleteSaleCommand}" CommandParameter="Card">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <Path Data="{StaticResource IconCard}" Stretch="Uniform" Width="22" Height="22"
                                      Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="Card" HorizontalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="digital" Height="72" Margin="5,0,0,0"
                                Command="{Binding CompleteSaleCommand}" CommandParameter="Digital">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <Path Data="{StaticResource IconPhone}" Stretch="Uniform" Width="22" Height="22"
                                      Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="Digital" HorizontalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ToggleButton x:Name="SplitToggle" Classes="split" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconSplit}" Width="16" Height="16"/>
                            <TextBlock Text="Split payment"/>
                        </StackPanel>
                    </ToggleButton>

                    <StackPanel Spacing="8" IsVisible="{Binding #SplitToggle.IsChecked}">
                        <Grid ColumnDefinitions="*,*">
                            <TextBox Grid.Column="0" Classes="field" Watermark="Cash amount" Text="{Binding CashTenderedText}" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Classes="field" Watermark="Card amount" Text="{Binding CardTenderedText}" Margin="4,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding SplitStatusText}" Classes="muted" FontSize="12"/>
                        <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Complete split payment" Command="{Binding CompleteSplitSaleCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
