<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FastTPV.Desktop.ViewModels"
        x:Class="FastTPV.Desktop.Views.InventoryWindow"
        x:DataType="vm:InventoryWindowViewModel"
        Title="Inventory Management"
        WindowState="Maximized"
        RequestedThemeVariant="Dark"
        Classes="app">

    <Grid RowDefinitions="Auto,*,44">
        <Border Classes="panel" Padding="20,14" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Inventory" Classes="h1" FontSize="20" VerticalAlignment="Center"/>
                <Button Content="Refresh" Classes="btn" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,360" Margin="16">
            <DockPanel Margin="0,0,16,0">
                <TextBox DockPanel.Dock="Top" Classes="field" Watermark="Search by name, code, or category..."
                         Text="{Binding SearchText}" Margin="0,0,0,12"/>
                <Border Classes="panel" CornerRadius="14" Padding="0" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding FilteredArticles}" SelectedItem="{Binding SelectedArticle}"
                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                              Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='{}{0:C}'}" Width="100"/>
                            <DataGridTextColumn Header="Mode" Binding="{Binding PricingMode}" Width="90"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockLevel}" Width="80"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding MinimumStock}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="14">
                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Add / Edit Product" Classes="h2"/>
                            <TextBlock Text="Code" Classes="muted" FontSize="12"/>
                            <TextBox Text="{Binding EditCode}" Classes="field"/>
                            <TextBlock Text="Name" Classes="muted" FontSize="12"/>
                            <TextBox Text="{Binding EditName}" Classes="field"/>
                            <TextBlock Text="Category" Classes="muted" FontSize="12"/>
                            <AutoCompleteBox Text="{Binding EditCategory}" ItemsSource="{Binding CategoryOptions}"
                                             Classes="field" MinHeight="48"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Spacing="4" Margin="0,0,5,0">
                                    <TextBlock Text="Price" Classes="muted" FontSize="12"/>
                                    <NumericUpDown Value="{Binding EditPrice}" FormatString="C" Minimum="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                    <TextBlock Text="Cost" Classes="muted" FontSize="12"/>
                                    <NumericUpDown Value="{Binding EditCostPrice}" FormatString="C" Minimum="0"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Spacing="4" Margin="0,0,5,0">
                                    <TextBlock Text="Stock" Classes="muted" FontSize="12"/>
                                    <NumericUpDown Value="{Binding EditStockLevel}" Minimum="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                    <TextBlock Text="Min stock" Classes="muted" FontSize="12"/>
                                    <NumericUpDown Value="{Binding EditMinimumStock}" Minimum="0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Pricing mode" Classes="muted" FontSize="12"/>
                            <ComboBox Classes="field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding PricingModeOptions}"
                                      SelectedItem="{Binding EditPricingMode}"/>
                            <TextBlock Text="Fixed = catalog price. OpenPrice = cashier enters amount on the POS keypad (fruit, bulk, etc.)."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                <Button Content="New" Classes="btn" Command="{Binding NewArticleCommand}"/>
                                <Button Content="Save" Classes="cash" Command="{Binding SaveCommand}"/>
                                <Button Content="Delete" Classes="danger" Command="{Binding DeleteCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Adjust Stock" Classes="h2"/>
                            <TextBlock Text="{Binding SelectedArticle.Name, StringFormat='For: {0}', TargetNullValue='Select a product in the grid first.'}"
                                       Classes="muted" FontSize="12"/>
                            <TextBlock Text="Quantity (+ to add, − to remove)" Classes="muted" FontSize="12"/>
                            <NumericUpDown Value="{Binding AdjustQuantityDelta}"/>
                            <TextBlock Text="Reason" Classes="muted" FontSize="12"/>
                            <TextBox Text="{Binding AdjustReason}" Classes="field" Watermark="e.g. Damaged, Recount, Supplier delivery"/>
                            <Button Content="Apply Adjustment" Classes="primary" HorizontalAlignment="Left"
                                    Command="{Binding AdjustStockCommand}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Classes="panel" BorderThickness="0,1,0,0" Padding="20,0">
            <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
